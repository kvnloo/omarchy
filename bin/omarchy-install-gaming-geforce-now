#!/bin/bash

# omarchy:summary=Install and launch Geforce Now.
# omarchy:group=install
# omarchy:name=gaming geforce-now

set -e

echo "Installing GeForce NOW..."
omarchy-pkg-add flatpak
# Download into a private directory, never a fixed name under /tmp: another
# local user could pre-plant /tmp/GeForceNOWSetup.bin as a symlink, and curl
# -O follows symlinks, so the download would land in an unrelated file while
# the chmod/exec below still run through the planted path.
installer_dir=$(mktemp -d)
trap 'rm -rf "$installer_dir"' EXIT
installer="$installer_dir/GeForceNOWSetup.bin"

# Download and run GeForce NOW
curl -L https://international.download.nvidia.com/GFNLinux/GeForceNOWSetup.bin -o "$installer"
chmod +x "$installer"
"$installer"

# Ensure a separate browser process not started by GFN is available.
# If not, it seems like GFN has a tendency to hang on login.
setsid omarchy-launch-browser
