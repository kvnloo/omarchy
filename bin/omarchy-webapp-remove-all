#!/bin/bash

# omarchy:summary=Remove all web apps installed via omarchy-webapp-install.

set -e

APP_DIR="${1:-$HOME/.local/share/applications}"
ICON_DIR="$HOME/.local/share/icons/hicolor/256x256/apps"
OLD_ICON_DIR="$HOME/.local/share/applications/icons"

echo "Scanning for web apps in $APP_DIR..."

webapp_desktop_files=()
while IFS= read -r -d '' file; do
  if grep -q "Exec=omarchy-launch-webapp\|Exec=omarchy-webapp-handler" "$file" 2>/dev/null; then
    webapp_desktop_files+=("$file")
  fi
# Scan recursively like omarchy-webapp-remove does: installs predating the
# name validation could nest the launcher inside directories, and a
# top-level-only scan would leave those web apps behind.
done < <(find "$APP_DIR" -name "*.desktop" -print0 2>/dev/null)

if (( ${#webapp_desktop_files[@]} == 0 )); then
  echo "No web apps found."
  exit 0
fi

for file in "${webapp_desktop_files[@]}"; do
  app_name=$(basename "$file" .desktop)
  icon_name=$(printf '%s\n' "$app_name" | tr '[:upper:]' '[:lower:]' | sed 's/[^[:alnum:]]\+/-/g; s/^-//; s/-$//')
  echo "Removing web app: $app_name"
  rm -f "$file"
  # install_user_icon keeps the source file extension ($name.$ext), so a
  # local SVG/JPEG icon would survive a .png-only removal. icon_name is
  # sanitized to [a-z0-9-], so the glob cannot match dotfiles.
  if [[ -n $icon_name ]]; then
    rm -f "$ICON_DIR/$icon_name".*
  fi
  rm -f "$ICON_DIR/$app_name.png" "$OLD_ICON_DIR/$app_name.png"
done

if omarchy-cmd-present update-desktop-database; then
  update-desktop-database "$APP_DIR" &>/dev/null || true
fi

echo "Web apps removed successfully."
