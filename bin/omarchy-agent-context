#!/bin/bash

# omarchy:summary=Show a minimal workspace snapshot for an explicitly invoked agent
# omarchy:args=[--json] [--focused]
# omarchy:examples=omarchy agent context --json | omarchy agent context --focused
# omarchy:hidden=true

set -euo pipefail

focused_only=false
seen_json=false
for arg in "$@"; do
  case "$arg" in
    --json)
      if [[ $seen_json == true ]]; then
        echo "Usage: omarchy agent context [--json] [--focused]" >&2
        exit 1
      fi
      seen_json=true
      ;;
    --focused)
      if [[ $focused_only == true ]]; then
        echo "Usage: omarchy agent context [--json] [--focused]" >&2
        exit 1
      fi
      focused_only=true
      ;;
    *)
      echo "Usage: omarchy agent context [--json] [--focused]" >&2
      exit 1
      ;;
  esac
done

# This command is deliberately invoked on demand; do not run it as a shell
# service or send its output to a model without the user's request.
for dependency in hyprctl jq timeout; do
  if ! command -v "$dependency" >/dev/null; then
    printf 'omarchy-agent-context: missing %s\n' "$dependency" >&2
    exit 127
  fi
done

if ! monitors=$(timeout 2s hyprctl -j monitors); then
  echo "omarchy-agent-context: cannot read monitors" >&2
  exit 1
fi

if ! workspaces=$(timeout 2s hyprctl -j workspaces); then
  echo "omarchy-agent-context: cannot read workspaces" >&2
  exit 1
fi

# Never forward raw Hyprland JSON: it includes window titles, client IDs,
# hardware identifiers and other unneeded values. Build an explicit allowlist.
if ! snapshot=$(
  # Keep raw Hyprland JSON off argv (which other processes may inspect).
  # jq reads the two source documents from stdin, and emits only the allowlist.
  printf '%s\n%s\n' "$monitors" "$workspaces" | jq -cs --argjson focusedOnly "$focused_only" '
    if length != 2 or (.[0] | type) != "array" or (.[1] | type) != "array" then
      error("unexpected Hyprland shape")
    else
      .[0] as $monitors | .[1] as $workspaces |
      {
        schemaVersion: 1,
        monitors: ($monitors |
          (if $focusedOnly then map(select(.focused == true)) else . end) |
          map({
            name: (.name // ""),
            focused: (.focused == true),
            activeWorkspace: {
              id: (.activeWorkspace.id // null),
              name: (.activeWorkspace.name // "")
            }
          })),
        workspaces: ($workspaces |
          (if $focusedOnly then
            map(select(.id as $id | any($monitors[]; .focused == true and .activeWorkspace.id == $id)))
           else . end) |
          map({
            id: (.id // null),
            name: (.name // ""),
            monitor: (.monitor // ""),
            windows: (.windows // 0)
          }))
      }
    end
  ' 2>/dev/null
); then
  echo "omarchy-agent-context: invalid Hyprland response" >&2
  exit 1
fi

printf '%s\n' "$snapshot"
