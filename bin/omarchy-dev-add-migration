#!/bin/bash

# omarchy:summary=Create a new Omarchy migration in the current source tree.
# omarchy:args=[--no-edit]

set -euo pipefail

no_edit=0

while (($#)); do
  case "$1" in
    --no-edit)
      no_edit=1
      shift
      ;;
    system|user)
      echo "omarchy-dev-add-migration: migration scopes are no longer used; creating a regular migration." >&2
      shift
      ;;
    -h|--help)
      echo "Usage: omarchy-dev-add-migration [--no-edit]"
      exit 0
      ;;
    *)
      echo "Unknown option: $1" >&2
      echo "Usage: omarchy-dev-add-migration [--no-edit]" >&2
      exit 1
      ;;
  esac
done

cd "${OMARCHY_PATH:-$(pwd)}"
mkdir -p migrations

timestamp=$(git log -1 --format=%cd --date=unix)
migration_file="migrations/$timestamp.sh"

# The name is the last commit's date, so two migrations created before the
# next commit share it: the second would silently reuse (and the editor open)
# the first one's file. Keep the chronological naming and bump until free.
while [[ -e $migration_file ]]; do
  ((timestamp += 1))
  migration_file="migrations/$timestamp.sh"
done
touch "$migration_file"

if (( ! no_edit )); then
  nvim "$migration_file"
fi

printf '%s\n' "$PWD/$migration_file"
