#!/bin/bash

# omarchy:summary=Remove a terminal UI desktop launcher
# omarchy:args=[name]

set -e

ICON_DIR="$HOME/.local/share/icons/hicolor/256x256/apps"
OLD_ICON_DIR="$HOME/.local/share/applications/icons"
DESKTOP_DIR="$HOME/.local/share/applications/"

# The name becomes a filename. A slash would turn it into directory levels, so a
# crafted name like ../foo walks out of the applications directory and deletes
# files the launcher never owned. Refuse rather than act on what the user typed
# (mirrors omarchy-tui-install's require_plain_name).
require_plain_name() {
  if [[ $1 == */* ]]; then
    echo "TUI name cannot contain '/': $1" >&2
    exit 1
  fi
}

# Always index the launchers, so removal deletes the file that was found rather
# than a path rebuilt from the displayed name.
TUI_NAMES=()
TUI_PATHS=()
while IFS= read -r -d '' file; do
  if grep -qE '^Exec=.*(\$TERMINAL|xdg-terminal-exec).*-e' "$file" 2>/dev/null; then
    TUI_NAMES+=("$(basename "${file%.desktop}")")
    TUI_PATHS+=("$file")
  fi
done < <(find "$DESKTOP_DIR" -name '*.desktop' -print0 2>/dev/null)

# The launcher matching a chosen name, or empty when nothing was indexed under
# it (an app removed between the scan and the pick, say).
path_for_tui() {
  local wanted="$1" i
  for i in "${!TUI_NAMES[@]}"; do
    if [[ ${TUI_NAMES[$i]} == "$wanted" ]]; then
      printf '%s\n' "${TUI_PATHS[$i]}"
      return 0
    fi
  done
}

if (( $# == 0 )); then
  # Find all TUIs
  if ((${#TUI_NAMES[@]})); then
    mapfile -t SORTED_TUIS < <(printf '%s\n' "${TUI_NAMES[@]}" | sort)
    APP_NAME=$(omarchy-menu-select "Select TUI to remove" "${SORTED_TUIS[@]}" -- --width 520 --maxheight 520)
  else
    echo "No TUIs to remove."
    exit 1
  fi
else
  APP_NAME="$*"
  require_plain_name "$APP_NAME"
fi

if [[ -z $APP_NAME ]]; then
  echo "You must select a TUI to remove."
  exit 1
fi

icon_name=$(printf '%s\n' "$APP_NAME" | tr '[:upper:]' '[:lower:]' | sed 's/[^[:alnum:]]\+/-/g; s/^-//; s/-$//')
desktop_file=$(path_for_tui "$APP_NAME")
rm -f "${desktop_file:-$DESKTOP_DIR/$APP_NAME.desktop}"
rm -f "$ICON_DIR/$icon_name.png" "$ICON_DIR/$APP_NAME.png" "$OLD_ICON_DIR/$APP_NAME.png"
if [[ ${OMARCHY_REMOVE_NOTIFY:-true} != "false" ]]; then
  omarchy-notification-send -g  "TUI removed" "$APP_NAME"
fi
