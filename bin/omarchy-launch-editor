#!/bin/bash

# omarchy:summary=Launch the default editor selected via Omarchy defaults.
# omarchy:args=[--inline] <path>

default_editor="$HOME/.local/state/omarchy/defaults/editor"

if [[ ${1:-} == "--inline" ]]; then
  inline=true
  shift
else
  inline=false
fi

if [[ -f $default_editor ]]; then
  read -r editor <"$default_editor"
else
  editor="nvim"
fi

# sublime-text-4 ships `subl` on PATH, not `sublime_text`.
[[ $editor == sublime_text ]] && editor=subl

omarchy-cmd-present "$editor" || editor="nvim"

case "${editor##*/}" in
nvim | vim | nano | micro | hx | helix | fresh)
  if [[ $inline == "true" ]]; then
    exec "$editor" -- "$@"
  else
    exec omarchy-launch-tui "$editor" -- "$@"
  fi
  ;;
*)
  if [[ $inline == "true" ]]; then
    wait_flag=()
    case "${editor##*/}" in
    code | code-insiders | codium | cursor | windsurf | zed | zeditor | gedit)
      wait_flag=(--wait)
      ;;
    subl)
      wait_flag=(-w)
      ;;
    gnome-text-editor)
      # GNOME Text Editor has no --wait option (its only CLI flags are
      # --ignore-session, --new-window, --standalone, --version, per
      # editor-application.c upstream); it rejects --wait as unknown.
      # --standalone spawns a fresh non-unique instance that exits with its
      # window, so `setsid -w` still blocks until the user is done.
      wait_flag=(--standalone)
      ;;
    esac
    exec setsid -w uwsm-app -- "$editor" "${wait_flag[@]}" -- "$@"
  else
    exec setsid uwsm-app -- "$editor" -- "$@"
  fi
  ;;
esac
