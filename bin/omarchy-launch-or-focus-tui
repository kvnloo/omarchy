#!/bin/bash

# omarchy:summary=Launch a TUI or focus an existing terminal window for it
# omarchy:args=[--app-id=<app-id>] <command> [args...]

if [[ ${1:-} == --app-id=* ]]; then
  APP_ID="${1#--app-id=}"
else
  APP_ID="org.omarchy.$(basename "$1")"
fi

# Quote each argument so the single eval round in omarchy-launch-or-focus
# restores the original argv: an argument carrying spaces, quotes, or $(...)
# must neither be re-split nor executed when the string is re-parsed.
LAUNCH_COMMAND="omarchy-launch-tui $(printf '%q ' "$@")"

exec omarchy-launch-or-focus "$APP_ID" "$LAUNCH_COMMAND"
