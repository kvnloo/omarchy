#!/bin/bash

# omarchy:summary=Lock the computer and turn off the display
# omarchy:group=system
# omarchy:name=lock
# omarchy:examples=omarchy system lock

omarchy-shell lock lock >/dev/null

# Set keyboard layout to default (first layout)
hyprctl switchxkblayout all 0 > /dev/null 2>&1

# Ensure 1password is locked. Use timeout because `1password --lock` can
# otherwise leave a full Electron helper tree running after each lock.
if pgrep -x "1password" >/dev/null && omarchy-cmd-present 1password; then
  # The lock lives in a private, owner-verified runtime directory
  # (omarchy-lock-dir): no other local user can plant a pathname there, so
  # there is no attacker-writable transition between validation and open.
  one_password_lock=""
  if lock_dir=$(omarchy-lock-dir 2>/dev/null); then
    one_password_lock="$lock_dir/omarchy-1password-lock.lock"
  fi
  # Sanity check: this script is the only writer of the lock path, so anything
  # but a regular file here is foreign. Refusing -- not replacing -- keeps the
  # flock mutual exclusion intact, and the screen still locks: only the
  # 1password helper lock is skipped. (A FIFO would hang the open.) The
  # directory itself is already private, so unlike a bare check-then-open
  # under /tmp, nothing can race this inspection. If the lock directory is
  # unusable, skip the helper lock but still lock the screen.
  if [[ -z $one_password_lock || -L $one_password_lock || ( -e $one_password_lock && ! -f $one_password_lock ) ]]; then
    [[ -z $one_password_lock ]] || echo "Refusing to use non-regular 1password lock: $one_password_lock" >&2
  else
    (
      flock -n 9 || exit 0
      timeout --kill-after=1s 3s 1password --lock >/dev/null 2>&1 || true
    ) 9>"$one_password_lock" &
  fi
fi

# Avoid running screensaver when locked
pkill -x ttfx 2>/dev/null || true
# ttfx handles SIGTERM asynchronously, so keep its terminal alive until it exits.
timeout 1s pidwait -x ttfx 2>/dev/null || true
pkill -f '[o]rg.omarchy.screensaver' 2>/dev/null || true
