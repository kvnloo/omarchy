#!/bin/bash

# omarchy:summary=Returns true if the AUR is up and available.

# --connect-timeout bounds only the handshake; --max-time bounds the whole
# attempt. A server that connects then stalls mid-response would otherwise
# hang every update forever (--retry never fires on a hung connection).
curl -sf --connect-timeout 30 --max-time 30 --retry 3 --retry-delay 3 -A "omarchy-update" \
  "https://aur.archlinux.org/rpc/?v=5&type=info&arg=base" >/dev/null
